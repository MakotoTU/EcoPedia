<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EcoPedia" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
    </style>

    <style name="Theme.EcoPedia" parent="Base.Theme.EcoPedia" />

    <!-- Toolbar Title Style -->
    <style name="ToolbarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Splash Screen API Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/leaf</item>
        <item name="windowSplashScreenBackground">@color/background_light</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/leaf</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/background_light</item>
        <item name="postSplashScreenTheme">@style/Theme.EcoPedia</item>
    </style>
</resources>